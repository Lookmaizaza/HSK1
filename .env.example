# OpenRouter — for LLM pronunciation grading
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Turso (libSQL) — for users + progress storage in production.
# Leave both blank in local dev; the app falls back to file:data/hsk.db.
# Sign up + create a DB at https://turso.tech, then run:
#   turso db tokens create your-db-name
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ThaiLLM (Pathumma by NECTEC) — alternative model for Thai-friendly feedback
# Request access at https://thaillm.or.th
THAILLM_API_KEY=

# Comma-separated usernames that get /admin dashboard access (case-insensitive)
ADMIN_USERNAMES=
