# ── App / admin ───────────────────────────────────────────────────────────────
# Comma-separated usernames that get /admin access (case-insensitive).
# Leave blank to keep the admin dashboard locked to nobody.
ADMIN_USERNAMES=

# ── Database (Turso / libSQL) ─────────────────────────────────────────────────
# Leave both blank in local dev; the app falls back to file:data/hsk.db.
# Create a database at https://turso.tech, then:
#   turso db tokens create your-db-name
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Optional: Neon PostgreSQL mirror ─────────────────────────────────────────
# Used by the Svelte app to mirror pronunciation evaluations and by the
# FastAPI backend in ./backend. Example:
# postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── LLM providers ─────────────────────────────────────────────────────────────
# OpenRouter — pronunciation grading / conversation (server-side only).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ThaiLLM (Pathumma by NECTEC) — Thai-friendly feedback alternative.
# Request access at https://thaillm.or.th
THAILLM_API_KEY=

# ── Research export ──────────────────────────────────────────────────────────
# Salt used to pseudonymize user IDs in PDPA research exports.
# Set a long random value in production; otherwise a default is derived.
RESEARCH_EXPORT_SALT=

# ── FastAPI backend (backend/) ───────────────────────────────────────────────
# Comma-separated allowed browser origins. Never set "*" together with
# credentials. Defaults to localhost + the production origin.
CORS_ORIGINS=
